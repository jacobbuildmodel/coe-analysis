# Citation metadata for this repository. GitHub reads this file for the
# "Cite this repository" button. Zenodo reads .zenodo.json instead, which
# carries the same metadata. Keep the two in step.
cff-version: 1.2.0
message: "If you use this data or code, please cite it as below."
type: software
title: "COE analysis"
authors:
